# Copy to .env and fill in. Never commit .env (it is gitignored).
# Changes to .env apply on the next page load of the app; no restart needed.
# You can also switch provider / model / key from the app: sidebar -> "Model & API key".

# ---- which model answers (swap freely, no code changes) -------------------------------
# LLM_PROVIDER: gemini | openrouter | groq | openai   (openai = ANY OpenAI-compatible endpoint)
LLM_PROVIDER=gemini
# Leave LLM_MODEL empty to use the provider's default model.
LLM_MODEL=gemini-3.5-flash
# Tried in order if the model above runs out of daily quota (same provider + key).
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite

# ---- API keys ------------------------------------------------------------------------
# LLM_API_KEY is used for whichever provider is selected. Or set one key per provider below,
# and the app picks the right one when you switch (it never sends one provider's key to another).
LLM_API_KEY=
# Gemini: https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# provider=openai (any OpenAI-compatible endpoint)
OPENAI_API_KEY=

# Only for provider=openai (or to point openrouter/groq elsewhere), e.g. a gateway Kuku provides:
# LLM_BASE_URL=https://your-gateway.example.com/v1

# ---- examples --------------------------------------------------------------------------
# OpenRouter:   LLM_PROVIDER=openrouter   LLM_MODEL=anthropic/claude-sonnet-4.5   OPENROUTER_API_KEY=...
# Groq:         LLM_PROVIDER=groq         LLM_MODEL=openai/gpt-oss-120b           GROQ_API_KEY=...
# Any gateway:  LLM_PROVIDER=openai       LLM_MODEL=<model id>  LLM_BASE_URL=<url>/v1  LLM_API_KEY=...

LLM_TEMPERATURE=0.2
LLM_RPM=8                 # client-side throttle, keep under your tier's per-minute limit
LLM_MAX_RETRIES=4
LLM_CONCURRENCY=4         # episodes / critic batches processed in parallel (each call takes ~1 min)

# ---- pipeline knobs --------------------------------------------------------------------
MAX_HOOKS_PER_EPISODE=6
MAX_CLIFFS_PER_EPISODE=6
CANDIDATES_PER_EPISODE=3  # windows per episode sent to the critic after dedup
CRITIC_BATCH_SIZE=5
# ANCHORCUT_WORKSPACE=./workspace
